{
  // dna-ts is a DNA package: dna/ is authored by hand and is the last
  // layer of its own instantiation. "role": "dna" is also what makes this
  // package usable as a layer at all — a dna/ folder alone does not.
  "version": 1,
  "role": "dna",

  // The parent DNA: the individual ggdna topic layers, which replace the
  // deprecated @tssuite/dna-base monolith. Declared as regular
  // dependencies in package.json, so npm installs them transitively for
  // every consumer. Not @ggdna/dna-ggdna and not @ggdna/dna-helix: this
  // layer carries the TypeScript topic, the authoring topic is not part
  // of it.
  "layers": [
    "@ggdna/dna-readme",
    "@ggdna/dna-guides",
    "@ggdna/dna-translate",
    "@ggdna/dna-index",
    "@ggdna/dna-blog",
    "@ggdna/dna-install",
    "@ggdna/dna-vscode",
    "@ggdna/dna-clean-code",
    "@ggdna/dna-gg"
  ]
}
