# .gitignore
# Node modules
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Build artifacts
dist/
build/

# Coverage reports
coverage/

# OS-specific files
.DS_Store
Thumbs.db

# IDE and editor files
*.swp
*.swo
*.swn

# Optional npm cache files
.npm/

# Other
*.lock  # (Optional: for ignoring package-lock.json or yarn.lock if you don't want to version them)

# gg tooling state — keep the DNA config, drop the rest
.gg/*
!.gg/gg.json
.gg/gg-publish.json
.gg/pubspec_overrides_backup.yaml
.gg/pnpm_workspace_backup.yaml
.gg/publish_config.json
.gg/publish_state.json

# dna-readme
/doc/*/guides/
/doc/*/templates/
/scripts/

# dna-gg
/CLAUDE.md
