{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@tssuite/dna-ts",

  // 1-2 sentence summary about this repo.
  "summary": "DNA of all TypeScript projects: the ggdna topic layers plus TS editor settings, snippets, review skill and the DNA spec. npm @tssuite/dna-ts.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "TypeScript project conventions",
    "VS Code settings, extensions, snippets for TS",
    "DNA wrapper spec test/dna/dna.spec.ts",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "helix-js": "DNA engine for TypeScript, runDnaTest",
      "dna-readme, dna-guides, dna-translate, dna-index, dna-blog, dna-install, dna-vscode, dna-clean-code, dna-gg": "topic layers",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "TypeScript repos": "layer",
    },
  },
}
